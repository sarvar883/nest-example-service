{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "resolvePackageJsonExports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "declaration": false,
        "noEmitOnError": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "ES2023",
        "sourceMap": true,
        "outDir": "./build",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": false,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "services": [
                "./src/app/services"
            ],
            "services/*": [
                "./src/app/services/*"
            ],
            "usecases": [
                "./src/app/usecases"
            ],
            "usecases/*": [
                "./src/app/usecases/*"
            ],
            "domain": [
                "./src/domain"
            ],
            "domain/*": [
                "./src/domain/*"
            ],
            "infrastructure": [
                "./src/infrastructure"
            ],
            "infrastructure/*": [
                "./src/infrastructure/*"
            ],
            "di": [
                "./src/infrastructure/di"
            ],
            "di/*": [
                "./src/infrastructure/di/*"
            ]
        }
    },
    "exclude": [
        "./typings/**/*",
        "node_modules",
        "build"
    ],
    "include": [
        "src",
        "test"
    ]
}