{
    "$schema": "https://json.schemastore.org/nest-cli",
    "entryFile": "app/services/api/main.js",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true
    },
    "projects": {
        "api": {
            "type": "application",
            "root": "app/services/api",
            "entryFile": "main",
            "sourceRoot": "app/services/api"
        },
        "processor": {
            "type": "application",
            "root": "app/services/processor",
            "entryFile": "main",
            "sourceRoot": "app/services/processor"
        }
    }
}
